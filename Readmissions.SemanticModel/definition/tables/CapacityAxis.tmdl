table CapacityAxis
	lineageTag: 24bd23dd-5537-4de2-9343-6dbbeb5e651d

	column Share
		dataType: double
		formatString: 0%
		lineageTag: 37baa404-8c8f-43f9-8ad8-3486556fc78f
		summarizeBy: none
		sourceColumn: Share

	partition CapacityAxis = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\CapacityAxis.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Clean = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Clean, {{"Share", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

