	partition Patients = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\patients.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Clean = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Clean, {{"RowKey", Int64.Type}, {"AgeBand", type text}, {"AgeOrder", Int64.Type}, {"AgeGroup", type text}, {"AgeGroupOrder", Int64.Type}, {"Gender", type text}, {"Race", type text}, {"Discharge", type text}, {"Diagnosis", type text}, {"AdmissionType", type text}, {"LengthOfStay", Int64.Type}, {"LOSGroup", type text}, {"PriorInpatient", Int64.Type}, {"PriorGroup", type text}, {"HbA1cTested", Int64.Type}, {"HbA1cStatus", type text}, {"Readmitted", Int64.Type}, {"IsTest", Int64.Type}, {"RiskScore", type number}, {"RiskDecile", Int64.Type}, {"ReferenceFlag20", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

