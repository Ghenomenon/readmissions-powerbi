model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Patients","Capacity","CapacityAxis","Scenario","ModelMetrics","OddsRatios","EffectSizes","ROC","ScenarioAxis","DataFolder"]

annotation PBI_ProTooling = ["DevMode"]

ref table Patients
ref table Capacity
ref table CapacityAxis
ref table Scenario
ref table ModelMetrics
ref table OddsRatios
ref table EffectSizes
ref table ROC
ref table ScenarioAxis

ref cultureInfo en-US

